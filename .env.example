# STB API credentials (server-side only, never exposed to the browser).
# Used by the Vite dev proxy, scripts, and integration tests.
# Extract from the official STB web app's JS bundle at info.stb.ro
STB_APP_ID=<your-app-id>
STB_APP_KEY=<your-app-key>

# STB API proxy URL for production builds.
# Set this to your deployed Cloudflare Worker URL.
# In development, the Vite dev proxy handles this automatically.
VITE_STB_API_BASE=https://alt-stb-proxy.<your-subdomain>.workers.dev
