{
  "name": "alt-infotb-pmtiles-pipeline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.node-test.ts browser/*.node-test.ts",
    "generate": "node src/cli.ts generate",
    "verify": "node src/cli.ts verify",
    "build:preview": "vite build",
    "test:browser": "playwright test",
    "build:storage": "vite build --config vite.storage.config.ts && node src/build-storage-shell.ts",
    "test:storage": "playwright test --config playwright.storage.config.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.5.1",
    "@noble/hashes": "2.4.0",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
