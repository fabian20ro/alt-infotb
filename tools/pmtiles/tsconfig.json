{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@noble/hashes/*": ["./node_modules/@noble/hashes/*"]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "*.ts",
    "preview/**/*.ts",
    "browser/**/*.ts",
    "storage-preview/**/*.ts",
    "storage-browser/**/*.ts"
  ]
}
